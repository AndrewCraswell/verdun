{
  "private": true,
  "name": "verdun",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0 <12.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "server": "pnpm --filter @verdun/server local",
    "load-test": "node scripts/load-test.mjs",
    "format": "oxfmt",
    "check:format": "oxfmt --check",
    "check:lint": "turbo run lint",
    "check:types": "turbo run check:types",
    "check:unused": "knip",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "verify": "run-s check:format check:lint check:types check:unused test:coverage build",
    "lockfile:normalize": "node scripts/normalize-lockfile.mjs",
    "assets:unpack": "node scripts/extract-unitypackage.mjs",
    "assets:pack": "node scripts/build-asset-pack.mjs",
    "assets:backup": "node scripts/backup-assets.mjs",
    "assets:fetch": "node scripts/backup-assets.mjs --fetch",
    "map:backdrop": "node scripts/sector-backdrop.mjs",
    "map:check": "node scripts/check-sector.mjs",
    "map:export-tiled": "node scripts/export-tiled.mjs",
    "prepare": "lefthook install",
    "map:analyze": "node scripts/analyze-sector.mjs",
    "map:elevation": "node scripts/fetch-elevation.mjs",
    "map:places": "node scripts/fetch-places.mjs",
    "map:battle-maps": "node scripts/fetch-battle-maps.mjs",
    "map:front": "node scripts/build-front-map.mjs",
    "weather:build": "node scripts/build-historical-weather.mjs",
    "sound:voices": "node scripts/generate-voices.mjs scripts/voice-lines.json",
    "sound:fetch": "node scripts/fetch-sound-sources.mjs",
    "sound:music": "node scripts/build-music.mjs",
    "balance": "node scripts/balance.mjs",
    "perf": "node scripts/perf.mjs --headed"
  },
  "devDependencies": {
    "knip": "^6.42.1",
    "lefthook": "^2.2.2",
    "npm-run-all2": "^9.0.4",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "turbo": "2.11.10"
  },
  "packageManager": "pnpm@11.9.0"
}
