{
  "name": "@verdun/sim",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Pure, deterministic game simulation: ECS world, fixed-timestep stepping, commands and snapshots.",
  "exports": {
    ".": "./src/index.ts",
