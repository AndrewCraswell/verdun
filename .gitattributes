* text=auto eol=lf
*.png binary
*.jpg binary
*.ktx2 binary
*.glb binary
*.bin binary

# The level kit and the soundtrack the game ships: in Git LFS, so rebuilding them doesn't swell the history.
.asset-cache/level/**/*.glb filter=lfs diff=lfs merge=lfs -text
.asset-cache/level/**/*.png filter=lfs diff=lfs merge=lfs -text
.asset-cache/level/**/*.ktx2 filter=lfs diff=lfs merge=lfs -text
.asset-cache/level/**/*.ogg filter=lfs diff=lfs merge=lfs -text
.asset-cache/music/**/*.ogg filter=lfs diff=lfs merge=lfs -text
