# Dependencies and build output
node_modules/
dist/
.turbo/
coverage/
*.tsbuildinfo
*.log

# Claude Code personal settings
.claude/settings.local.json

# Raw vendor assets (FBX, .blend, .uasset, source textures). Never commit: license and size.
vendor/

# Asset pipeline output. The level kit and the soundtrack the game ships are committed, through Git LFS
# (.gitattributes); the rest is rebuilt from vendor/ and backed up with it (docs/assets/backup.md).
.asset-cache/*
!.asset-cache/level/
!.asset-cache/music/
# A sound build's work in progress, renamed into place when it's done.
.asset-cache/level/*.building/

# Unreal export project
unreal/

# Environment
.env
.env.*
!.env.example

# OS and editor
.DS_Store
Thumbs.db

# The built client CI copies in to deploy (deploy/Dockerfile).
deploy/site/

# What pnpm map:check draws of a sector as generated, for its Tiled file.
packages/map/sectors/*-generated.png
