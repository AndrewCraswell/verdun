{
  "name": "@verdun/server",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "The sector server: runs the battle on its own clock whoever is playing, and keeps it in SQLite across restarts.",
  "scripts": {
    "check:types": "tsc --noEmit",
    "lint": "oxlint --max-warnings=0",
    "local": "node src/main.ts --dev",
    "start": "node src/main.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@colyseus/core": "catalog:",
    "@colyseus/ws-transport": "catalog:",
    "@verdun/map": "workspace:*",
    "@verdun/net": "workspace:*",
    "@verdun/sim": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@verdun/oxlint-config": "workspace:*",
    "@verdun/typescript-config": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
